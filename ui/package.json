{
  "name": "codex-notifier-ui",
  "displayName": "Codex Beacon",
  "description": "按项目管理 Codex 任务、状态灯、token 与费用估算，以及完成提醒。Project tasks, status, token usage, cost estimates and alerts for Codex.",
  "version": "0.6.0",
  "publisher": "lengmo1996",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Extension Packs",
    "Other"
  ],
  "extensionPack": [
    "lengmo1996.codex-notifier-collector"
  ],
  "extensionKind": [
    "ui"
  ],
  "api": "none",
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:codexNotifier.internal.receive",
    "onCommand:codexNotifier.internal.snapshot"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "codexNotifier.dashboard",
        "title": "%command.codexNotifier.dashboard%",
        "icon": "$(dashboard)",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.dashboard.zhCN",
        "title": "打开 Codex Beacon 仪表盘",
        "icon": "$(dashboard)"
      },
      {
        "command": "codexNotifier.dashboard.en",
        "title": "Open Codex Beacon dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "codexNotifier.chooseSound",
        "title": "%command.codexNotifier.chooseSound%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.testSound",
        "title": "%command.codexNotifier.testSound%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.openProjectWindow",
        "title": "%command.codexNotifier.openProjectWindow%",
        "icon": "$(window)",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.chooseOpenLocation",
        "title": "%command.codexNotifier.chooseOpenLocation%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.checkInstallation",
        "title": "%command.codexNotifier.checkInstallation%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.menu",
        "title": "%command.codexNotifier.menu%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.testNotification",
        "title": "%command.codexNotifier.testNotification%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.showHistory",
        "title": "%command.codexNotifier.showHistory%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.openNext",
        "title": "%command.codexNotifier.openNext%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.showEntry",
        "title": "%command.codexNotifier.showEntry%",
        "icon": "$(go-to-file)",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.markEntryRead",
        "title": "%command.codexNotifier.markEntryRead%",
        "icon": "$(check)",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.showEntryDetails",
        "title": "%command.codexNotifier.showEntryDetails%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.pause",
        "title": "%command.codexNotifier.pause%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.resume",
        "title": "%command.codexNotifier.resume%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.markRead",
        "title": "%command.codexNotifier.markRead%",
        "icon": "$(check-all)",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.clearHistory",
        "title": "%command.codexNotifier.clearHistory%",
        "icon": "$(trash)",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.configureApprovalHook",
        "title": "%command.codexNotifier.configureApprovalHook%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.removeApprovalHook",
        "title": "%command.codexNotifier.removeApprovalHook%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.showStatus",
        "title": "%command.codexNotifier.showStatus%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.settings",
        "title": "%command.codexNotifier.settings%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.deleteEntry",
        "title": "%command.codexNotifier.deleteEntry%",
        "icon": "$(trash)",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.clearRead",
        "title": "%command.codexNotifier.clearRead%",
        "icon": "$(clear-all)",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.testCollector",
        "title": "%command.codexNotifier.testCollector%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.restartCollector",
        "title": "%command.codexNotifier.restartCollector%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.privacy",
        "title": "%command.codexNotifier.privacy%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.clearPrivateData",
        "title": "%command.codexNotifier.clearPrivateData%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.clearLocalPrivateData",
        "title": "%command.codexNotifier.clearLocalPrivateData%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.resumePrivateData",
        "title": "%command.codexNotifier.resumePrivateData%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.chooseLanguage",
        "title": "%command.codexNotifier.chooseLanguage%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.toggleGrouping",
        "title": "%command.codexNotifier.toggleGrouping%",
        "icon": "$(list-tree)",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.clearHistory.zhCN",
        "title": "Codex 通知：清空全部通知",
        "icon": "$(trash)"
      },
      {
        "command": "codexNotifier.clearHistory.en",
        "title": "Clear all notifications",
        "icon": "$(trash)"
      },
      {
        "command": "codexNotifier.clearRead.zhCN",
        "title": "Codex 通知：清空已读通知",
        "icon": "$(clear-all)"
      },
      {
        "command": "codexNotifier.clearRead.en",
        "title": "Clear read notifications",
        "icon": "$(clear-all)"
      },
      {
        "command": "codexNotifier.deleteEntry.zhCN",
        "title": "删除这条通知",
        "icon": "$(trash)"
      },
      {
        "command": "codexNotifier.deleteEntry.en",
        "title": "Delete this notification",
        "icon": "$(trash)"
      },
      {
        "command": "codexNotifier.markEntryRead.zhCN",
        "title": "静默标为已读",
        "icon": "$(check)"
      },
      {
        "command": "codexNotifier.markEntryRead.en",
        "title": "Mark read silently",
        "icon": "$(check)"
      },
      {
        "command": "codexNotifier.markRead.zhCN",
        "title": "Codex 通知：全部标为已读",
        "icon": "$(check-all)"
      },
      {
        "command": "codexNotifier.markRead.en",
        "title": "Mark all read",
        "icon": "$(check-all)"
      },
      {
        "command": "codexNotifier.menu.zhCN",
        "title": "Codex 通知：打开菜单"
      },
      {
        "command": "codexNotifier.menu.en",
        "title": "Open notification menu"
      },
      {
        "command": "codexNotifier.openProjectWindow.zhCN",
        "title": "打开项目窗口",
        "icon": "$(window)"
      },
      {
        "command": "codexNotifier.openProjectWindow.en",
        "title": "Open project window",
        "icon": "$(window)"
      },
      {
        "command": "codexNotifier.showEntry.zhCN",
        "title": "打开对应会话并标为已读",
        "icon": "$(go-to-file)"
      },
      {
        "command": "codexNotifier.showEntry.en",
        "title": "Open session and mark this notification read",
        "icon": "$(go-to-file)"
      },
      {
        "command": "codexNotifier.showEntryDetails.zhCN",
        "title": "查看通知详情"
      },
      {
        "command": "codexNotifier.showEntryDetails.en",
        "title": "Show notification details"
      },
      {
        "command": "codexNotifier.toggleGrouping.zhCN",
        "title": "Codex Beacon：切换项目／通知分组",
        "icon": "$(list-tree)"
      },
      {
        "command": "codexNotifier.toggleGrouping.en",
        "title": "Toggle project or notification grouping",
        "icon": "$(list-tree)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexNotifier",
          "title": "Codex Beacon",
          "icon": "assets/bell.svg"
        }
      ]
    },
    "views": {
      "codexNotifier": [
        {
          "id": "codexNotifier.history",
          "name": "%view.tasks%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "codexNotifier.dashboard.en",
          "when": "(view == codexNotifier.history) && codexNotifier.menuLanguage == en",
          "group": "navigation@-1"
        },
        {
          "command": "codexNotifier.dashboard.zhCN",
          "when": "(view == codexNotifier.history) && codexNotifier.menuLanguage == zh-CN",
          "group": "navigation@-1"
        },
        {
          "command": "codexNotifier.toggleGrouping.zhCN",
          "when": "(view == codexNotifier.history) && codexNotifier.menuLanguage == zh-CN",
          "group": "navigation@0"
        },
        {
          "command": "codexNotifier.toggleGrouping.en",
          "when": "(view == codexNotifier.history) && codexNotifier.menuLanguage == en",
          "group": "navigation@0"
        },
        {
          "command": "codexNotifier.clearRead.zhCN",
          "when": "(view == codexNotifier.history) && codexNotifier.menuLanguage == zh-CN",
          "group": "2_cleanup@1"
        },
        {
          "command": "codexNotifier.clearRead.en",
          "when": "(view == codexNotifier.history) && codexNotifier.menuLanguage == en",
          "group": "2_cleanup@1"
        },
        {
          "command": "codexNotifier.markRead.zhCN",
          "when": "(view == codexNotifier.history) && codexNotifier.menuLanguage == zh-CN",
          "group": "1_read@1"
        },
        {
          "command": "codexNotifier.markRead.en",
          "when": "(view == codexNotifier.history) && codexNotifier.menuLanguage == en",
          "group": "1_read@1"
        },
        {
          "command": "codexNotifier.clearHistory.zhCN",
          "when": "(view == codexNotifier.history) && codexNotifier.menuLanguage == zh-CN",
          "group": "2_cleanup@2"
        },
        {
          "command": "codexNotifier.clearHistory.en",
          "when": "(view == codexNotifier.history) && codexNotifier.menuLanguage == en",
          "group": "2_cleanup@2"
        },
        {
          "command": "codexNotifier.menu.zhCN",
          "when": "(view == codexNotifier.history) && codexNotifier.menuLanguage == zh-CN",
          "group": "3_tools@1"
        },
        {
          "command": "codexNotifier.menu.en",
          "when": "(view == codexNotifier.history) && codexNotifier.menuLanguage == en",
          "group": "3_tools@1"
        }
      ],
      "view/item/context": [
        {
          "command": "codexNotifier.openProjectWindow.zhCN",
          "when": "(view == codexNotifier.history && (viewItem == projectTaskGroup || viewItem == readNotification || viewItem == unreadNotification)) && codexNotifier.menuLanguage == zh-CN",
          "group": "inline@0"
        },
        {
          "command": "codexNotifier.openProjectWindow.en",
          "when": "(view == codexNotifier.history && (viewItem == projectTaskGroup || viewItem == readNotification || viewItem == unreadNotification)) && codexNotifier.menuLanguage == en",
          "group": "inline@0"
        },
        {
          "command": "codexNotifier.markEntryRead.zhCN",
          "when": "(view == codexNotifier.history && viewItem == unreadNotification) && codexNotifier.menuLanguage == zh-CN",
          "group": "inline"
        },
        {
          "command": "codexNotifier.markEntryRead.en",
          "when": "(view == codexNotifier.history && viewItem == unreadNotification) && codexNotifier.menuLanguage == en",
          "group": "inline"
        },
        {
          "command": "codexNotifier.showEntry.zhCN",
          "when": "(view == codexNotifier.history && (viewItem == readNotification || viewItem == unreadNotification)) && codexNotifier.menuLanguage == zh-CN",
          "group": "navigation"
        },
        {
          "command": "codexNotifier.showEntry.en",
          "when": "(view == codexNotifier.history && (viewItem == readNotification || viewItem == unreadNotification)) && codexNotifier.menuLanguage == en",
          "group": "navigation"
        },
        {
          "command": "codexNotifier.showEntryDetails.zhCN",
          "when": "(view == codexNotifier.history && (viewItem == readNotification || viewItem == unreadNotification)) && codexNotifier.menuLanguage == zh-CN",
          "group": "navigation"
        },
        {
          "command": "codexNotifier.showEntryDetails.en",
          "when": "(view == codexNotifier.history && (viewItem == readNotification || viewItem == unreadNotification)) && codexNotifier.menuLanguage == en",
          "group": "navigation"
        },
        {
          "command": "codexNotifier.deleteEntry.zhCN",
          "when": "(view == codexNotifier.history && (viewItem == readNotification || viewItem == unreadNotification)) && codexNotifier.menuLanguage == zh-CN",
          "group": "inline@2"
        },
        {
          "command": "codexNotifier.deleteEntry.en",
          "when": "(view == codexNotifier.history && (viewItem == readNotification || viewItem == unreadNotification)) && codexNotifier.menuLanguage == en",
          "group": "inline@2"
        },
        {
          "command": "codexNotifier.deleteEntry.zhCN",
          "when": "(view == codexNotifier.history && (viewItem == readNotification || viewItem == unreadNotification)) && codexNotifier.menuLanguage == zh-CN",
          "group": "notification"
        },
        {
          "command": "codexNotifier.deleteEntry.en",
          "when": "(view == codexNotifier.history && (viewItem == readNotification || viewItem == unreadNotification)) && codexNotifier.menuLanguage == en",
          "group": "notification"
        },
        {
          "command": "codexNotifier.clearRead.zhCN",
          "when": "(view == codexNotifier.history && viewItem == readNotificationGroup) && codexNotifier.menuLanguage == zh-CN",
          "group": "inline"
        },
        {
          "command": "codexNotifier.clearRead.en",
          "when": "(view == codexNotifier.history && viewItem == readNotificationGroup) && codexNotifier.menuLanguage == en",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "codexNotifier.openProjectWindow",
          "when": "false"
        },
        {
          "command": "codexNotifier.showEntry",
          "when": "false"
        },
        {
          "command": "codexNotifier.markEntryRead",
          "when": "false"
        },
        {
          "command": "codexNotifier.showEntryDetails",
          "when": "false"
        },
        {
          "command": "codexNotifier.deleteEntry",
          "when": "false"
        },
        {
          "command": "codexNotifier.clearHistory.zhCN",
          "when": "false"
        },
        {
          "command": "codexNotifier.clearHistory.en",
          "when": "false"
        },
        {
          "command": "codexNotifier.clearRead.zhCN",
          "when": "false"
        },
        {
          "command": "codexNotifier.clearRead.en",
          "when": "false"
        },
        {
          "command": "codexNotifier.deleteEntry.zhCN",
          "when": "false"
        },
        {
          "command": "codexNotifier.deleteEntry.en",
          "when": "false"
        },
        {
          "command": "codexNotifier.markEntryRead.zhCN",
          "when": "false"
        },
        {
          "command": "codexNotifier.markEntryRead.en",
          "when": "false"
        },
        {
          "command": "codexNotifier.markRead.zhCN",
          "when": "false"
        },
        {
          "command": "codexNotifier.markRead.en",
          "when": "false"
        },
        {
          "command": "codexNotifier.menu.zhCN",
          "when": "false"
        },
        {
          "command": "codexNotifier.menu.en",
          "when": "false"
        },
        {
          "command": "codexNotifier.openProjectWindow.zhCN",
          "when": "false"
        },
        {
          "command": "codexNotifier.openProjectWindow.en",
          "when": "false"
        },
        {
          "command": "codexNotifier.showEntry.zhCN",
          "when": "false"
        },
        {
          "command": "codexNotifier.showEntry.en",
          "when": "false"
        },
        {
          "command": "codexNotifier.showEntryDetails.zhCN",
          "when": "false"
        },
        {
          "command": "codexNotifier.showEntryDetails.en",
          "when": "false"
        },
        {
          "command": "codexNotifier.toggleGrouping.zhCN",
          "when": "false"
        },
        {
          "command": "codexNotifier.toggleGrouping.en",
          "when": "false"
        },
        {
          "command": "codexNotifier.dashboard.zhCN",
          "when": "false"
        },
        {
          "command": "codexNotifier.dashboard.en",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "codexNotifier.notificationsEnabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%setting.codexNotifier.notificationsEnabled%"
        },
        "codexNotifier.desktopNotifications": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%setting.codexNotifier.desktopNotifications%"
        },
        "codexNotifier.sound": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%setting.codexNotifier.sound%"
        },
        "codexNotifier.soundFile": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%setting.codexNotifier.soundFile%"
        },
        "codexNotifier.taskbarAttention": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%setting.codexNotifier.taskbarAttention%"
        },
        "codexNotifier.blinkWindowTitle": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%setting.codexNotifier.blinkWindowTitle%"
        },
        "codexNotifier.notifyOnDone": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%setting.codexNotifier.notifyOnDone%"
        },
        "codexNotifier.notifyOnApproval": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%setting.codexNotifier.notifyOnApproval%"
        },
        "codexNotifier.notifyOnQuestion": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%setting.codexNotifier.notifyOnQuestion%"
        },
        "codexNotifier.onlyWhenUnfocused": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "%setting.codexNotifier.onlyWhenUnfocused%"
        },
        "codexNotifier.autoReadOnWindowFocus": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "%setting.codexNotifier.autoReadOnWindowFocus%"
        },
        "codexNotifier.openLocation": {
          "type": "string",
          "enum": [
            "sidebar",
            "editor"
          ],
          "enumDescriptions": [
            "%setting.codexNotifier.openLocation.option.0%",
            "%setting.codexNotifier.openLocation.option.1%"
          ],
          "default": "sidebar",
          "scope": "application",
          "description": "%setting.codexNotifier.openLocation%"
        },
        "codexNotifier.localCodexHome": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "%setting.codexNotifier.localCodexHome%"
        },
        "codexNotifier.localPythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "%setting.codexNotifier.localPythonPath%"
        },
        "codexNotifier.localSourceLabel": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "%setting.codexNotifier.localSourceLabel%"
        },
        "codexNotifier.localCollectorEnabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "%setting.codexNotifier.localCollectorEnabled%"
        },
        "codexNotifier.soundOnDone": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%setting.codexNotifier.soundOnDone%"
        },
        "codexNotifier.desktopOnDone": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "%setting.codexNotifier.desktopOnDone%"
        },
        "codexNotifier.localCacheRetentionDays": {
          "type": "integer",
          "default": 7,
          "minimum": 1,
          "maximum": 30,
          "scope": "window",
          "description": "%setting.codexNotifier.localCacheRetentionDays%"
        },
        "codexNotifier.historyRetentionDays": {
          "type": "integer",
          "default": 7,
          "minimum": 1,
          "maximum": 30,
          "scope": "application",
          "description": "%setting.codexNotifier.historyRetentionDays%"
        },
        "codexNotifier.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh-CN",
            "en"
          ],
          "default": "auto",
          "scope": "application",
          "enumDescriptions": [
            "%language.option.0%",
            "%language.option.1%",
            "%language.option.2%"
          ],
          "description": "%setting.codexNotifier.language%"
        },
        "codexNotifier.groupBy": {
          "type": "string",
          "enum": [
            "project",
            "history"
          ],
          "default": "project",
          "scope": "application",
          "description": "%setting.codexNotifier.groupBy%"
        },
        "codexNotifier.modelPrices": {
          "type": "object",
          "default": {},
          "scope": "application",
          "additionalProperties": {
            "type": "object",
            "required": [
              "input",
              "cachedInput",
              "output"
            ],
            "additionalProperties": false,
            "properties": {
              "input": {
                "type": "number",
                "minimum": 0
              },
              "cachedInput": {
                "type": "number",
                "minimum": 0
              },
              "cacheWrite": {
                "type": "number",
                "minimum": 0
              },
              "output": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "description": "%setting.codexNotifier.modelPrices%"
        },
        "codexNotifier.pricingContext": {
          "type": "string",
          "enum": [
            "short",
            "long"
          ],
          "default": "short",
          "scope": "application",
          "description": "%setting.codexNotifier.pricingContext%"
        },
        "codexNotifier.pricingTier": {
          "type": "string",
