{
  "name": "codex-beacon",
  "displayName": "Codex Beacon",
  "description": "Track Codex tasks by project with a compact dashboard, colored states, token usage and completion alerts.",
  "version": "0.8.0",
  "publisher": "Young581",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Extension Packs",
    "Other"
  ],
  "extensionPack": [
    "Young581.codex-beacon-collector"
  ],
  "extensionKind": [
    "ui"
  ],
  "api": "none",
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:codexBeacon.internal.receive",
    "onCommand:codexBeacon.internal.snapshot"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "codexBeacon.dashboard",
        "title": "%command.codexBeacon.dashboard%",
        "icon": "$(dashboard)",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.dashboard.zhCN",
        "title": "打开 Codex Beacon 仪表盘",
        "icon": "$(dashboard)"
      },
      {
        "command": "codexBeacon.dashboard.en",
        "title": "Open Codex Beacon dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "codexBeacon.chooseSound",
        "title": "%command.codexBeacon.chooseSound%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.testSound",
        "title": "%command.codexBeacon.testSound%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.openProjectWindow",
        "title": "%command.codexBeacon.openProjectWindow%",
        "icon": "$(window)",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.chooseOpenLocation",
        "title": "%command.codexBeacon.chooseOpenLocation%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.checkInstallation",
        "title": "%command.codexBeacon.checkInstallation%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.menu",
        "title": "%command.codexBeacon.menu%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.testNotification",
        "title": "%command.codexBeacon.testNotification%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.showHistory",
        "title": "%command.codexBeacon.showHistory%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.openNext",
        "title": "%command.codexBeacon.openNext%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.showEntry",
        "title": "%command.codexBeacon.showEntry%",
        "icon": "$(go-to-file)",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.markEntryRead",
        "title": "%command.codexBeacon.markEntryRead%",
        "icon": "$(check)",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.showEntryDetails",
        "title": "%command.codexBeacon.showEntryDetails%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.pause",
        "title": "%command.codexBeacon.pause%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.resume",
        "title": "%command.codexBeacon.resume%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.markRead",
        "title": "%command.codexBeacon.markRead%",
        "icon": "$(check-all)",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.clearHistory",
        "title": "%command.codexBeacon.clearHistory%",
        "icon": "$(trash)",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.configureApprovalHook",
        "title": "%command.codexBeacon.configureApprovalHook%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.removeApprovalHook",
        "title": "%command.codexBeacon.removeApprovalHook%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.showStatus",
        "title": "%command.codexBeacon.showStatus%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.settings",
        "title": "%command.codexBeacon.settings%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.deleteEntry",
        "title": "%command.codexBeacon.deleteEntry%",
        "icon": "$(trash)",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.clearRead",
        "title": "%command.codexBeacon.clearRead%",
        "icon": "$(clear-all)",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.testCollector",
        "title": "%command.codexBeacon.testCollector%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.restartCollector",
        "title": "%command.codexBeacon.restartCollector%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.privacy",
        "title": "%command.codexBeacon.privacy%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.clearPrivateData",
        "title": "%command.codexBeacon.clearPrivateData%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.clearLocalPrivateData",
        "title": "%command.codexBeacon.clearLocalPrivateData%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.resumePrivateData",
        "title": "%command.codexBeacon.resumePrivateData%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.chooseLanguage",
        "title": "%command.codexBeacon.chooseLanguage%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.toggleGrouping",
        "title": "%command.codexBeacon.toggleGrouping%",
        "icon": "$(list-tree)",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.clearHistory.zhCN",
        "title": "Codex 通知：清空全部通知",
        "icon": "$(trash)"
      },
      {
        "command": "codexBeacon.clearHistory.en",
        "title": "Clear all notifications",
        "icon": "$(trash)"
      },
      {
        "command": "codexBeacon.clearRead.zhCN",
        "title": "Codex 通知：清空已读通知",
        "icon": "$(clear-all)"
      },
      {
        "command": "codexBeacon.clearRead.en",
        "title": "Clear read notifications",
        "icon": "$(clear-all)"
      },
      {
        "command": "codexBeacon.deleteEntry.zhCN",
        "title": "删除这条通知",
        "icon": "$(trash)"
      },
      {
        "command": "codexBeacon.deleteEntry.en",
        "title": "Delete this notification",
        "icon": "$(trash)"
      },
      {
        "command": "codexBeacon.markEntryRead.zhCN",
        "title": "静默标为已读",
        "icon": "$(check)"
      },
      {
        "command": "codexBeacon.markEntryRead.en",
        "title": "Mark read silently",
        "icon": "$(check)"
      },
      {
        "command": "codexBeacon.markRead.zhCN",
        "title": "Codex 通知：全部标为已读",
        "icon": "$(check-all)"
      },
      {
        "command": "codexBeacon.markRead.en",
        "title": "Mark all read",
        "icon": "$(check-all)"
      },
      {
        "command": "codexBeacon.menu.zhCN",
        "title": "Codex 通知：打开菜单"
      },
      {
        "command": "codexBeacon.menu.en",
        "title": "Open notification menu"
      },
      {
        "command": "codexBeacon.openProjectWindow.zhCN",
        "title": "打开项目窗口",
        "icon": "$(window)"
      },
      {
        "command": "codexBeacon.openProjectWindow.en",
        "title": "Open project window",
        "icon": "$(window)"
      },
      {
        "command": "codexBeacon.showEntry.zhCN",
        "title": "打开对应会话并标为已读",
        "icon": "$(go-to-file)"
      },
      {
        "command": "codexBeacon.showEntry.en",
        "title": "Open session and mark this notification read",
        "icon": "$(go-to-file)"
      },
      {
        "command": "codexBeacon.showEntryDetails.zhCN",
        "title": "查看通知详情"
      },
      {
        "command": "codexBeacon.showEntryDetails.en",
        "title": "Show notification details"
      },
      {
        "command": "codexBeacon.toggleGrouping.zhCN",
        "title": "Codex Beacon：切换项目／通知分组",
        "icon": "$(list-tree)"
      },
      {
        "command": "codexBeacon.toggleGrouping.en",
        "title": "Toggle project or notification grouping",
        "icon": "$(list-tree)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexBeacon",
          "title": "Codex Beacon",
          "icon": "assets/bell.svg"
        }
      ]
    },
    "views": {
      "codexBeacon": [
        {
          "id": "codexBeacon.history",
          "name": "%view.tasks%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "codexBeacon.dashboard.en",
          "when": "(view == codexBeacon.history) && codexBeacon.menuLanguage == en",
          "group": "navigation@-1"
        },
        {
          "command": "codexBeacon.dashboard.zhCN",
          "when": "(view == codexBeacon.history) && codexBeacon.menuLanguage == zh-CN",
          "group": "navigation@-1"
        },
        {
          "command": "codexBeacon.toggleGrouping.zhCN",
          "when": "(view == codexBeacon.history) && codexBeacon.menuLanguage == zh-CN",
          "group": "navigation@0"
        },
        {
          "command": "codexBeacon.toggleGrouping.en",
          "when": "(view == codexBeacon.history) && codexBeacon.menuLanguage == en",
          "group": "navigation@0"
        },
        {
          "command": "codexBeacon.clearRead.zhCN",
          "when": "(view == codexBeacon.history) && codexBeacon.menuLanguage == zh-CN",
          "group": "2_cleanup@1"
        },
        {
          "command": "codexBeacon.clearRead.en",
          "when": "(view == codexBeacon.history) && codexBeacon.menuLanguage == en",
          "group": "2_cleanup@1"
        },
        {
          "command": "codexBeacon.markRead.zhCN",
          "when": "(view == codexBeacon.history) && codexBeacon.menuLanguage == zh-CN",
          "group": "1_read@1"
        },
        {
          "command": "codexBeacon.markRead.en",
          "when": "(view == codexBeacon.history) && codexBeacon.menuLanguage == en",
          "group": "1_read@1"
        },
        {
          "command": "codexBeacon.clearHistory.zhCN",
          "when": "(view == codexBeacon.history) && codexBeacon.menuLanguage == zh-CN",
          "group": "2_cleanup@2"
        },
        {
          "command": "codexBeacon.clearHistory.en",
          "when": "(view == codexBeacon.history) && codexBeacon.menuLanguage == en",
          "group": "2_cleanup@2"
        },
        {
          "command": "codexBeacon.menu.zhCN",
          "when": "(view == codexBeacon.history) && codexBeacon.menuLanguage == zh-CN",
          "group": "3_tools@1"
        },
        {
          "command": "codexBeacon.menu.en",
          "when": "(view == codexBeacon.history) && codexBeacon.menuLanguage == en",
          "group": "3_tools@1"
        }
      ],
      "view/item/context": [
        {
          "command": "codexBeacon.openProjectWindow.zhCN",
          "when": "(view == codexBeacon.history && (viewItem == projectTaskGroup || viewItem == readNotification || viewItem == unreadNotification)) && codexBeacon.menuLanguage == zh-CN",
          "group": "inline@0"
        },
        {
          "command": "codexBeacon.openProjectWindow.en",
          "when": "(view == codexBeacon.history && (viewItem == projectTaskGroup || viewItem == readNotification || viewItem == unreadNotification)) && codexBeacon.menuLanguage == en",
          "group": "inline@0"
        },
        {
          "command": "codexBeacon.markEntryRead.zhCN",
          "when": "(view == codexBeacon.history && viewItem == unreadNotification) && codexBeacon.menuLanguage == zh-CN",
          "group": "inline"
        },
        {
          "command": "codexBeacon.markEntryRead.en",
          "when": "(view == codexBeacon.history && viewItem == unreadNotification) && codexBeacon.menuLanguage == en",
          "group": "inline"
        },
        {
          "command": "codexBeacon.showEntry.zhCN",
          "when": "(view == codexBeacon.history && (viewItem == readNotification || viewItem == unreadNotification)) && codexBeacon.menuLanguage == zh-CN",
          "group": "navigation"
        },
        {
          "command": "codexBeacon.showEntry.en",
          "when": "(view == codexBeacon.history && (viewItem == readNotification || viewItem == unreadNotification)) && codexBeacon.menuLanguage == en",
          "group": "navigation"
        },
        {
          "command": "codexBeacon.showEntryDetails.zhCN",
          "when": "(view == codexBeacon.history && (viewItem == readNotification || viewItem == unreadNotification)) && codexBeacon.menuLanguage == zh-CN",
          "group": "navigation"
        },
        {
          "command": "codexBeacon.showEntryDetails.en",
          "when": "(view == codexBeacon.history && (viewItem == readNotification || viewItem == unreadNotification)) && codexBeacon.menuLanguage == en",
          "group": "navigation"
        },
        {
          "command": "codexBeacon.deleteEntry.zhCN",
          "when": "(view == codexBeacon.history && (viewItem == readNotification || viewItem == unreadNotification)) && codexBeacon.menuLanguage == zh-CN",
          "group": "inline@2"
        },
        {
          "command": "codexBeacon.deleteEntry.en",
          "when": "(view == codexBeacon.history && (viewItem == readNotification || viewItem == unreadNotification)) && codexBeacon.menuLanguage == en",
          "group": "inline@2"
        },
        {
          "command": "codexBeacon.deleteEntry.zhCN",
          "when": "(view == codexBeacon.history && (viewItem == readNotification || viewItem == unreadNotification)) && codexBeacon.menuLanguage == zh-CN",
          "group": "notification"
        },
        {
          "command": "codexBeacon.deleteEntry.en",
          "when": "(view == codexBeacon.history && (viewItem == readNotification || viewItem == unreadNotification)) && codexBeacon.menuLanguage == en",
          "group": "notification"
        },
        {
          "command": "codexBeacon.clearRead.zhCN",
          "when": "(view == codexBeacon.history && viewItem == readNotificationGroup) && codexBeacon.menuLanguage == zh-CN",
          "group": "inline"
        },
        {
          "command": "codexBeacon.clearRead.en",
          "when": "(view == codexBeacon.history && viewItem == readNotificationGroup) && codexBeacon.menuLanguage == en",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "codexBeacon.openProjectWindow",
          "when": "false"
        },
        {
          "command": "codexBeacon.showEntry",
          "when": "false"
        },
        {
          "command": "codexBeacon.markEntryRead",
          "when": "false"
        },
        {
          "command": "codexBeacon.showEntryDetails",
          "when": "false"
        },
        {
          "command": "codexBeacon.deleteEntry",
          "when": "false"
        },
        {
          "command": "codexBeacon.clearHistory.zhCN",
          "when": "false"
        },
        {
          "command": "codexBeacon.clearHistory.en",
          "when": "false"
        },
        {
          "command": "codexBeacon.clearRead.zhCN",
          "when": "false"
        },
        {
          "command": "codexBeacon.clearRead.en",
          "when": "false"
        },
        {
          "command": "codexBeacon.deleteEntry.zhCN",
          "when": "false"
        },
        {
          "command": "codexBeacon.deleteEntry.en",
          "when": "false"
        },
        {
          "command": "codexBeacon.markEntryRead.zhCN",
          "when": "false"
        },
        {
          "command": "codexBeacon.markEntryRead.en",
          "when": "false"
        },
        {
          "command": "codexBeacon.markRead.zhCN",
          "when": "false"
        },
        {
          "command": "codexBeacon.markRead.en",
          "when": "false"
        },
        {
          "command": "codexBeacon.menu.zhCN",
          "when": "false"
        },
        {
          "command": "codexBeacon.menu.en",
          "when": "false"
        },
        {
          "command": "codexBeacon.openProjectWindow.zhCN",
          "when": "false"
        },
        {
          "command": "codexBeacon.openProjectWindow.en",
          "when": "false"
        },
        {
          "command": "codexBeacon.showEntry.zhCN",
          "when": "false"
        },
        {
          "command": "codexBeacon.showEntry.en",
          "when": "false"
        },
        {
          "command": "codexBeacon.showEntryDetails.zhCN",
          "when": "false"
        },
        {
          "command": "codexBeacon.showEntryDetails.en",
          "when": "false"
        },
        {
          "command": "codexBeacon.toggleGrouping.zhCN",
          "when": "false"
        },
        {
          "command": "codexBeacon.toggleGrouping.en",
          "when": "false"
        },
        {
          "command": "codexBeacon.dashboard.zhCN",
          "when": "false"
        },
        {
          "command": "codexBeacon.dashboard.en",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "codexBeacon.notificationsEnabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%setting.codexBeacon.notificationsEnabled%"
        },
        "codexBeacon.desktopNotifications": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%setting.codexBeacon.desktopNotifications%"
        },
        "codexBeacon.sound": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%setting.codexBeacon.sound%"
        },
        "codexBeacon.soundFile": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%setting.codexBeacon.soundFile%"
        },
        "codexBeacon.taskbarAttention": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%setting.codexBeacon.taskbarAttention%"
        },
        "codexBeacon.blinkWindowTitle": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%setting.codexBeacon.blinkWindowTitle%"
        },
        "codexBeacon.notifyOnDone": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%setting.codexBeacon.notifyOnDone%"
        },
        "codexBeacon.notifyOnApproval": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%setting.codexBeacon.notifyOnApproval%"
        },
        "codexBeacon.notifyOnQuestion": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%setting.codexBeacon.notifyOnQuestion%"
        },
        "codexBeacon.onlyWhenUnfocused": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "%setting.codexBeacon.onlyWhenUnfocused%"
        },
        "codexBeacon.autoReadOnWindowFocus": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "%setting.codexBeacon.autoReadOnWindowFocus%"
        },
        "codexBeacon.openLocation": {
          "type": "string",
          "enum": [
            "sidebar",
            "editor"
          ],
          "enumDescriptions": [
            "%setting.codexBeacon.openLocation.option.0%",
            "%setting.codexBeacon.openLocation.option.1%"
          ],
          "default": "sidebar",
          "scope": "application",
          "description": "%setting.codexBeacon.openLocation%"
        },
        "codexBeacon.localCodexHome": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "%setting.codexBeacon.localCodexHome%"
        },
        "codexBeacon.localPythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "%setting.codexBeacon.localPythonPath%"
        },
        "codexBeacon.localSourceLabel": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "%setting.codexBeacon.localSourceLabel%"
        },
        "codexBeacon.localCollectorEnabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "%setting.codexBeacon.localCollectorEnabled%"
        },
        "codexBeacon.soundOnDone": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%setting.codexBeacon.soundOnDone%"
        },
        "codexBeacon.desktopOnDone": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%setting.codexBeacon.desktopOnDone%"
        },
        "codexBeacon.localCacheRetentionDays": {
          "type": "integer",
          "default": 7,
          "minimum": 1,
          "maximum": 30,
          "scope": "window",
          "description": "%setting.codexBeacon.localCacheRetentionDays%"
        },
        "codexBeacon.historyRetentionDays": {
          "type": "integer",
          "default": 7,
          "minimum": 1,
          "maximum": 30,
          "scope": "application",
          "description": "%setting.codexBeacon.historyRetentionDays%"
        },
        "codexBeacon.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh-CN",
            "en"
          ],
          "default": "auto",
          "scope": "application",
          "enumDescriptions": [
            "%language.option.0%",
            "%language.option.1%",
            "%language.option.2%"
          ],
          "description": "%setting.codexBeacon.language%"
        },
        "codexBeacon.groupBy": {
          "type": "string",
          "enum": [
            "project",
            "history"
          ],
          "default": "project",
          "scope": "application",
          "description": "%setting.codexBeacon.groupBy%"
        },
        "codexBeacon.modelPrices": {
          "type": "object",
          "default": {},
          "scope": "application",
          "additionalProperties": {
            "type": "object",
            "required": [
              "input",
              "cachedInput",
              "output"
            ],
            "additionalProperties": false,
            "properties": {
              "input": {
                "type": "number",
                "minimum": 0
              },
              "cachedInput": {
                "type": "number",
                "minimum": 0
              },
              "cacheWrite": {
                "type": "number",
                "minimum": 0
              },
              "output": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "description": "%setting.codexBeacon.modelPrices%"
        },
        "codexBeacon.pricingContext": {
          "type": "string",
          "enum": [
            "short",
            "long"
          ],
          "default": "short",
          "scope": "application",
          "description": "%setting.codexBeacon.pricingContext%"
        },
        "codexBeacon.pricingTier": {
          "type": "string",
          "enum": [
            "auto",
            "standard",
            "fast",
            "ultrafast",
            "batch",
