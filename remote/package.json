{
  "name": "codex-beacon-collector",
  "displayName": "Codex Beacon Collector",
  "description": "Remote SSH and container event collection for Codex Beacon. Install the main extension on Windows.",
  "publisher": "Young581",
  "version": "0.5.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "api": "none",
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "采集进程与 Hook 配置仅在受信任工作区运行。 / Collection and hook configuration run only in trusted workspaces."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "codexBeacon.remote.status",
        "title": "%command.codexBeacon.remote.status%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.remote.configureApprovalHook",
        "title": "%command.codexBeacon.remote.configureApprovalHook%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.remote.removeApprovalHook",
        "title": "%command.codexBeacon.remote.removeApprovalHook%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.remote.test",
        "title": "%command.codexBeacon.remote.test%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexBeacon.remote.restart",
        "title": "%command.codexBeacon.remote.restart%",
        "category": "Codex Beacon"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "codexBeacon.codexHome": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "%setting.codexBeacon.codexHome%"
        },
        "codexBeacon.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "%setting.codexBeacon.pythonPath%"
        },
        "codexBeacon.sourceLabel": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "%setting.codexBeacon.sourceLabel%"
        },
        "codexBeacon.collectorEnabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "%setting.codexBeacon.collectorEnabled%"
        },
        "codexBeacon.cacheRetentionDays": {
          "type": "integer",
          "default": 7,
          "minimum": 1,
          "maximum": 30,
          "scope": "window",
          "description": "%setting.codexBeacon.cacheRetentionDays%"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Young581/codex-beacon.git",
    "directory": "remote"
  },
  "homepage": "https://github.com/Young581/codex-beacon#readme",
  "bugs": {
    "url": "https://github.com/Young581/codex-beacon/issues"
  },
  "icon": "assets/beacon.png",
  "keywords": [
    "codex",
    "notifications",
    "tasks",
    "tokens",
    "dashboard"
  ],
  "galleryBanner": {
    "color": "#17212b",
    "theme": "dark"
  }
}
