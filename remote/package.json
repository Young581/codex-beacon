{
  "name": "codex-notifier-collector",
  "displayName": "Codex 远端通知采集器（lengmo1996）",
  "description": "SSH／容器中的 Codex 通知采集器。Remote notification collector for VS Code Codex sessions; inactive locally.",
  "publisher": "lengmo1996",
  "version": "0.3.2",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "api": "none",
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "采集进程与 Hook 配置仅在受信任工作区运行。 / Collection and hook configuration run only in trusted workspaces."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "codexNotifier.remote.status",
        "title": "%command.codexNotifier.remote.status%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.remote.configureApprovalHook",
        "title": "%command.codexNotifier.remote.configureApprovalHook%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.remote.removeApprovalHook",
        "title": "%command.codexNotifier.remote.removeApprovalHook%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.remote.test",
        "title": "%command.codexNotifier.remote.test%",
        "category": "Codex Beacon"
      },
      {
        "command": "codexNotifier.remote.restart",
        "title": "%command.codexNotifier.remote.restart%",
        "category": "Codex Beacon"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "codexNotifier.codexHome": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "%setting.codexNotifier.codexHome%"
        },
        "codexNotifier.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "%setting.codexNotifier.pythonPath%"
        },
        "codexNotifier.sourceLabel": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "%setting.codexNotifier.sourceLabel%"
        },
        "codexNotifier.collectorEnabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "%setting.codexNotifier.collectorEnabled%"
        },
        "codexNotifier.cacheRetentionDays": {
          "type": "integer",
          "default": 7,
          "minimum": 1,
          "maximum": 30,
          "scope": "window",
          "description": "%setting.codexNotifier.cacheRetentionDays%"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Young581/codex-beacon.git",
    "directory": "remote"
  },
  "homepage": "https://github.com/Young581/codex-beacon#readme",
  "bugs": {
    "url": "https://github.com/Young581/codex-beacon/issues"
  }
}
